# Configure these paths on the local EDA server before --run-signoff.
ANALOGSKILLS_VIRTUOSO_BINARY=/path/to/virtuoso
# Set false when using an existing DISPLAY and Cadence internal Xvnc cannot start.
ANALOGSKILLS_VIRTUOSO_NOGRAPH=true
ANALOGSKILLS_CALIBRE_BINARY=/path/to/calibre
ANALOGSKILLS_CRN28HPCP_DRC_DECK=/path/to/Calibre/drc/calibre.drc
ANALOGSKILLS_CRN28HPCP_LVS_DECK=/path/to/Calibre/lvs/calibre.lvs
ANALOGSKILLS_VIRTUOSO_PDK_LIB_PATH=/path/to/CRN28HPCp
